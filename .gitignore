# Описания агентов — такое же знание о проекте, как docs/state.md, и терять
# его на свежем клоне незачем. Настройки и разрешения рядом остаются
# скрытыми: там пути и права конкретной машины.
#
# Исключается содержимое, а не сам каталог: закрыв `.claude/`, git в него
# не заходит вовсе, и обратное правило внутри уже не срабатывает.
.claude/*
!.claude/agents/
.DS_Store

# База чужого бота, принятого за основу: рабочие данные, в репозиторий им нельзя
bot/*.db
bot/*.db-journal

# Окружения чужого бота: его установщик создаёт venv прямо в дереве проекта
bot/venv/
bot/web_admin/venv/
bot/xuiweb/venv/
bot/website/venv/
bot/subpage/venv/
