# =========================================================================
#  Конфигурация. Скопируйте в .env (make env) и заполните значения.
#  Пустые SECURITY_*/BOT_WEBHOOK_SECRET/POSTGRES_PASSWORD генерируются
#  автоматически командой `make env`.
# =========================================================================

# --- приложение ----------------------------------------------------------
APP_ENV=dev                       # dev | prod
APP_DEBUG=false
APP_BRAND=Router Shop             # название бренда в текстах бота и админки
APP_BOT_USERNAME=                 # username бота без @ — нужен для deep-link
APP_TIMEZONE=Europe/Moscow        # пояс отображения; в БД всё в UTC
APP_CURRENCY=RUB

# --- логи ----------------------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                   # json (прод) | console (разработка)
LOG_SQL_ECHO=false                # печатать SQL — только для отладки

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=router_shop
POSTGRES_USER=router_shop
POSTGRES_PASSWORD=
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=10
POSTGRES_STATEMENT_TIMEOUT_MS=15000

# --- Redis ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=rs               # префикс ключей: FSM, кэш, rate-limit, nonce

# --- Telegram-бот --------------------------------------------------------
BOT_TOKEN=                        # токен от @BotFather
BOT_MODE=polling                  # polling (dev) | webhook (прод)
BOT_WEBHOOK_BASE_URL=             # https://<домен API>, без завершающего слэша
BOT_WEBHOOK_PATH=/tg/webhook
BOT_WEBHOOK_SECRET=               # X-Telegram-Bot-Api-Secret-Token
BOT_INTERNAL_PORT=8081
BOT_DROP_PENDING_UPDATES=false
BOT_OWNER_ID=                     # TG-id владельца: полные права + критичные алерты
BOT_ADMIN_IDS=                    # TG-id админов через запятую
BOT_SUPPORT_GROUP_ID=             # супергруппа с топиками (-100...) для тикетов
BOT_ALERTS_CHAT_ID=               # канал служебных алертов (-100...)

# --- API -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_PUBLIC_BASE_URL=http://localhost:8000   # из него собираются ссылки подписки
API_ADMIN_BASE_URL=http://localhost:8000
API_TRUSTED_PROXY_HOPS=1          # сколько прокси перед приложением (nginx = 1)
API_DOCS_ENABLED=false            # /docs в проде выключен

# --- безопасность --------------------------------------------------------
SECURITY_SECRET_KEY=              # подпись сессий и CSRF админки
SECURITY_ENCRYPTION_KEY=          # base64(32 байта): шифрование секретов устройств и TOTP
SECURITY_DEVICE_CLOCK_SKEW_SEC=300
SECURITY_DEVICE_NONCE_TTL_SEC=600
SECURITY_DEVICE_RATE_LIMIT_PER_MIN=60
SECURITY_ACTIVATION_ATTEMPTS_PER_HOUR=10
SECURITY_SUB_TOKEN_GRACE_HOURS=24 # сколько живёт старый токен подписки после ротации
SECURITY_SUB_DISTINCT_IP_ALERT=5  # разных IP на токене за час → алерт о перепродаже
SECURITY_ADMIN_LOGIN_MAX_ATTEMPTS=5
SECURITY_ADMIN_LOCKOUT_MINUTES=15
SECURITY_ADMIN_SESSION_TTL_HOURS=12

# --- подписка и устройства ----------------------------------------------
SUBSCRIPTION_GRACE_DAYS=3         # доступ работает N дней после окончания
SUBSCRIPTION_REMINDER_DAYS_BEFORE=7,3,1,0
SUBSCRIPTION_REMINDER_DAYS_AFTER=1,3
SUBSCRIPTION_DEVICES_PER_USER=1
SUBSCRIPTION_ACTIVATION_DEADLINE_DAYS=180
SUBSCRIPTION_HEARTBEAT_INTERVAL_MIN=10
SUBSCRIPTION_HEARTBEAT_OFFLINE_MIN=15
SUBSCRIPTION_HEARTBEAT_RETENTION_DAYS=30
SUBSCRIPTION_ACCESS_LOG_RETENTION_DAYS=30
SUBSCRIPTION_REFERRAL_BONUS_DAYS=14
SUBSCRIPTION_NODE_PREFIX=Router_  # обязательный префикс имени узла в подписке

# --- оплата: PLATEGA (docs.platega.io) -----------------------------------
PLATEGA_MERCHANT_ID=              # X-MerchantId из личного кабинета
PLATEGA_SECRET=                   # X-Secret из личного кабинета
PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_CREATE_PATH=/v2/transaction/process        # способ оплаты выбирает клиент
PLATEGA_CREATE_PATH_WITH_METHOD=/transaction/process
PLATEGA_STATUS_PATH=/transaction
PLATEGA_DEFAULT_METHOD=any        # any | sbp | card | international | crypto
PLATEGA_TIMEOUT_SEC=20
PLATEGA_ALLOWED_IPS=              # белый список IP для колбэков, через запятую (пусто — не проверять)
# Адрес для колбэка в кабинете PLATEGA: https://<домен API>/webhooks/platega

# --- nginx (только для docker-compose) -----------------------------------
NGINX_API_DOMAIN=api.example.ru   # на этом же домене живёт вебхук бота
NGINX_ADMIN_DOMAIN=admin.example.ru

# --- бэкапы --------------------------------------------------------------
BACKUP_KEEP_DAYS=14
BACKUP_S3_BUCKET=                 # пусто — выгрузка в облако отключена
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Sentry (опционально) ------------------------------------------------
SENTRY_DSN=                       # пусто — Sentry выключен
SENTRY_TRACES_SAMPLE_RATE=0.0
