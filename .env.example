# =========================================================================
#  Конфигурация. Скопируйте в .env командой `make env` и заполните значения.
#  Пустые POSTGRES_PASSWORD, SECURITY_* и BOT_WEBHOOK_SECRET генерируются
#  автоматически.
#
#  Комментарии — только на отдельных строках: docker compose не гарантирует
#  отрезание хвоста после значения.
# =========================================================================

# --- приложение ----------------------------------------------------------
# dev | prod
APP_ENV=dev
APP_DEBUG=false
# Название бренда в текстах бота и админки
APP_BRAND=Router Shop
# username бота без @ — нужен для deep-link и реферальных ссылок
APP_BOT_USERNAME=
# Пояс отображения; в БД всё хранится в UTC
APP_TIMEZONE=Europe/Moscow
APP_CURRENCY=RUB
# Куда складываются картинки товаров. В compose это том media_data —
# без тома они пропадают при каждой пересборке образа
APP_MEDIA_DIR=/app/media
APP_MEDIA_MAX_BYTES=3145728

# --- логи ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json (прод) | console (разработка)
LOG_FORMAT=json
# Печатать SQL — только для отладки
LOG_SQL_ECHO=false

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=router_shop
POSTGRES_USER=router_shop
POSTGRES_PASSWORD=
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=10
POSTGRES_STATEMENT_TIMEOUT_MS=15000

# --- Redis ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Префикс ключей: FSM, кэш, rate-limit, nonce
REDIS_KEY_PREFIX=rs

# --- Telegram-бот --------------------------------------------------------
# Токен от @BotFather
BOT_TOKEN=
# polling (dev) | webhook (прод)
BOT_MODE=polling
# https://<домен API>, без завершающего слэша
BOT_WEBHOOK_BASE_URL=
BOT_WEBHOOK_PATH=/tg/webhook
# X-Telegram-Bot-Api-Secret-Token
BOT_WEBHOOK_SECRET=
BOT_INTERNAL_PORT=8081
BOT_DROP_PENDING_UPDATES=false
# TG-id владельца: полные права и критичные алерты
BOT_OWNER_ID=
# TG-id админов через запятую
BOT_ADMIN_IDS=
# Супергруппа с топиками (-100...) для тикетов поддержки
BOT_SUPPORT_GROUP_ID=
# Канал служебных алертов (-100...)
BOT_ALERTS_CHAT_ID=

# --- API -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
# Внешний адрес API: из него собираются ссылки подписки для роутеров и полные
# адреса картинок каталога — фото в боте тянет Telegram, и localhost он не откроет
# Адрес, по которому приложение видно снаружи. Из него собираются все
# абсолютные ссылки: фото каталога, баннер, картинки витрины, инструкция,
# манифест прошивки. За прокси здесь стоит ПУБЛИЧНОЕ имя, а не адрес
# origin, — иначе витрина покажет origin в адресах картинок.
API_PUBLIC_BASE_URL=http://localhost:8000
# Имя, которое origin ждёт в Host за прокси. Нужно только оверлею
# docker-compose.origin.yml — см. deploy/proxy/README.md
ORIGIN_NAME=
API_ADMIN_BASE_URL=http://localhost:8000
# Сколько прокси перед приложением (nginx или Caddy = 1)
API_TRUSTED_PROXY_HOPS=1
# /docs в проде выключен
API_DOCS_ENABLED=false
# Токен для бота и его админки: парк роутеров и каталог они читают по HTTP,
# потому что живут отдельными процессами и до нашего Postgres не достают.
# У них он зовётся FLEET_API_TOKEN — задаётся обеим службам, боту и админке.
# Пусто — ручки выключены и отвечают 404
API_FLEET_TOKEN=

# --- приложение в Telegram (каталог, профиль, роутер, продление) ----------
# Токен бота, из которого приложение открывают. Нужен ровно для проверки
# подписи входа: Telegram подписывает initData ключом, выведенным из токена.
# Ничего этим токеном не отправляется. Пусто — приложение отвечает 404.
MINIAPP_BOT_TOKEN=
# Кому открыто, через запятую. Пусто значит «никому» — так и задумано:
# пока идёт обкатка, приложение не должно открыться у клиента по случайно
# найденной ссылке. Открыть всем — отдельное решение.
MINIAPP_ALLOWED_TG_IDS=
# Сколько живёт подпись входа, секунд. Сутки: приложение держат открытым
# долго, и час заставлял бы перезапускать его посреди оформления.
MINIAPP_INIT_DATA_MAX_AGE_SEC=86400

# --- безопасность --------------------------------------------------------
# Подпись сессий и CSRF админки
SECURITY_SECRET_KEY=
# base64(32 байта): шифрование секретов устройств и TOTP
SECURITY_ENCRYPTION_KEY=
SECURITY_DEVICE_CLOCK_SKEW_SEC=300
SECURITY_DEVICE_NONCE_TTL_SEC=600
SECURITY_DEVICE_RATE_LIMIT_PER_MIN=60
SECURITY_ACTIVATION_ATTEMPTS_PER_HOUR=10
# Сколько живёт старый токен подписки после ротации
SECURITY_SUB_TOKEN_GRACE_HOURS=24
# Разных IP на одном токене за час → алерт о возможной перепродаже
SECURITY_SUB_DISTINCT_IP_ALERT=5
SECURITY_ADMIN_LOGIN_MAX_ATTEMPTS=5
SECURITY_ADMIN_LOCKOUT_MINUTES=15
SECURITY_ADMIN_SESSION_TTL_HOURS=12
# Сессия клиента на сайте — дольше админской: заходить каждый день его никто не заставляет
SECURITY_CLIENT_SESSION_TTL_DAYS=30
# Попыток входа в час на пару «IP + адрес». Учётку клиента не блокируем:
# зная чужую почту, конкурент запирал бы человека снаружи
SECURITY_CLIENT_LOGIN_ATTEMPTS_PER_HOUR=20

# --- подписка и устройства ----------------------------------------------
# Доступ работает N дней после окончания оплаченного периода
SUBSCRIPTION_GRACE_DAYS=3
SUBSCRIPTION_REMINDER_DAYS_BEFORE=7,3,1,0
SUBSCRIPTION_REMINDER_DAYS_AFTER=1,3
SUBSCRIPTION_DEVICES_PER_USER=1
SUBSCRIPTION_ACTIVATION_DEADLINE_DAYS=180
SUBSCRIPTION_HEARTBEAT_INTERVAL_MIN=10
SUBSCRIPTION_HEARTBEAT_OFFLINE_MIN=15
SUBSCRIPTION_HEARTBEAT_RETENTION_DAYS=30
SUBSCRIPTION_ACCESS_LOG_RETENTION_DAYS=30
SUBSCRIPTION_REFERRAL_BONUS_DAYS=14
# Обязательный префикс имени узла в подписке
SUBSCRIPTION_NODE_PREFIX=Router_

# --- оплата: PLATEGA (docs.platega.io) -----------------------------------
# X-MerchantId из личного кабинета
PLATEGA_MERCHANT_ID=
# X-Secret из личного кабинета
PLATEGA_SECRET=
PLATEGA_BASE_URL=https://app.platega.io
# Способ оплаты выбирает клиент
PLATEGA_CREATE_PATH=/v2/transaction/process
PLATEGA_CREATE_PATH_WITH_METHOD=/transaction/process
PLATEGA_STATUS_PATH=/transaction
# any | sbp | card | international | crypto
PLATEGA_DEFAULT_METHOD=any
PLATEGA_TIMEOUT_SEC=20
# Белый список IP для колбэков через запятую; пусто — не проверять
PLATEGA_ALLOWED_IPS=
# Адрес колбэка в кабинете PLATEGA: https://<домен API>/webhooks/platega

# --- доступ к роутерам через frp -----------------------------------------
# Сервер frps остаётся на российской площадке, роутеры подключаются к нему сами.
FRP_ENABLED=false
# Хост и порт frps — те же, что прописаны в прошивке роутеров
FRP_SERVER_HOST=
FRP_SERVER_PORT=8443
# Токен frps и ключ STCP из конфига frps
FRP_TOKEN=
FRP_STCP_SECRET=
# У frps включён TLS на транспорте — visitor подключается так же
FRP_TLS_ENABLED=true
# API дашборда frps, например https://origin.example.ru:7500
FRP_DASHBOARD_URL=
FRP_DASHBOARD_USER=admin
FRP_DASHBOARD_PASSWORD=
# Контейнер visitor-туннелей и диапазон локальных портов
FRP_VISITOR_HOST=frpc
FRP_VISITOR_BASE_PORT=20000
# Путь к API статистики на самом роутере
FRP_STATS_PATH=/cgi-bin/stats
FRP_POLL_INTERVAL_SEC=60
FRP_METRICS_RETENTION_DAYS=14
# Доступ к консоли роутера
FRP_SSH_USER=root
# Прошивка выводит пароль root из MAC: sha256(mac_без_разделителей + соль), первые 16 знаков
FRP_SSH_PASSWORD_SALT=
# Стоковый пароль root — одинаковый на всех роутерах из партии.
# Задавать можно вместе с солью: пароли перебираются по очереди, сначала
# выведенный из MAC, потом этот. Так открывается и перепрошитый роутер,
# и тот, что приехал со склада как есть.
FRP_SSH_PASSWORD=
FRP_SSH_TIMEOUT_SEC=15
FRP_SSH_VISITOR_OFFSET=10000
# Префиксы имён туннелей, которые создаёт прошивка
FRP_LUCI_PREFIX=luci
FRP_SSH_PREFIX=ssh

# --- панель Remnawave ----------------------------------------------------
# Источник узлов доступа. Панель стоит рядом в своей docker-сети, поэтому
# обычно её зовут по имени контейнера, а не через публичный домен.
REMNAWAVE_ENABLED=false
REMNAWAVE_BASE_URL=http://remnawave-backend:3000
# Bearer-токен из настроек панели: раздел API-токенов
REMNAWAVE_TOKEN=
# X-Api-Key, если панель дополнительно закрыта прокси; иначе оставьте пустым
REMNAWAVE_PROXY_TOKEN=
REMNAWAVE_TIMEOUT_SEC=15
# false — если у панели самоподписанный сертификат
REMNAWAVE_VERIFY_TLS=true
# Пути API вынесены в переменные: панель развивается быстро, и переезд ручки
# не должен требовать нашего релиза. Проверить можно в разделе «Панель Remnawave».
REMNAWAVE_STATS_PATH=/api/system/stats
REMNAWAVE_NODES_PATH=/api/nodes
REMNAWAVE_HOSTS_PATH=/api/hosts
REMNAWAVE_USERS_PATH=/api/users
REMNAWAVE_SQUADS_PATH=/api/internal-squads
# Сквады, в которые попадает клиент при активации, через запятую.
# Без них учётка создастся, но узлов в её подписке не будет.
# UUID видны в админке: раздел «Панель Remnawave».
REMNAWAVE_SQUAD_UUIDS=
# Хост, через который роутер ходит за подпиской вместо домена панели.
# Панель отдаёт ссылку на себя, и её адрес оказывается прописан в прошивке
# у каждого клиента. Здесь задаётся прикрытие (домен за DDoS-Guard) — при
# доставке хост подменяется, путь и токен остаются панельными.
# Пусто — ссылка уходит роутеру такой, какой её выдала панель.
REMNAWAVE_SUB_PUBLIC_HOST=
# Имя учётки в панели. Доступны {tg_id}, {mac} и {user_id}
REMNAWAVE_USERNAME_TEMPLATE=tg{tg_id}_{mac}
# Для клиентов с сайта: Telegram у них нет, основной шаблон дал бы «tgNone_...»
REMNAWAVE_USERNAME_TEMPLATE_NO_TG=id{user_id}_{mac}
# Лимит трафика на клиента в байтах; 0 — без ограничения
REMNAWAVE_TRAFFIC_LIMIT_BYTES=0

# --- обратный прокси -----------------------------------------------------
# Для docker-compose.yml: домены нашего nginx
NGINX_API_DOMAIN=api.example.ru
NGINX_ADMIN_DOMAIN=admin.example.ru
# Для docker-compose.proxy.yml: имя внешней сети чужого прокси (Caddy, Traefik)
PROXY_NETWORK=
# Чтобы не указывать оба файла в каждой команде, раскомментируйте строку ниже
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml

# --- бэкапы --------------------------------------------------------------
BACKUP_KEEP_DAYS=14
# Пусто — выгрузка в облако отключена
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Sentry (опционально) ------------------------------------------------
# Пусто — Sentry выключен
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Копия собранных списков доменов в объектном хранилище. Списки тянет весь
# парк разом, и выкат нашего сервера не должен оставлять роутеры без
# обновления. Провайдеры S3-совместимы, различается только адрес:
#   Yandex — https://storage.yandexcloud.net
#   VK     — https://hb.vkcs.cloud
# Пустой bucket выключает выкладку: списки всё равно отдаются с нашего домена.
LISTS_POLL_INTERVAL_MIN=10
# Каталог на диске для копии собранных списков — если те же файлы отдаёт
# свой веб-сервер с другого домена. Правится и на странице списков.
LISTS_LOCAL_DIR=
LISTS_S3_BUCKET=
LISTS_S3_ENDPOINT=
LISTS_S3_REGION=ru-central1
LISTS_S3_ACCESS_KEY=
LISTS_S3_SECRET_KEY=
LISTS_S3_PREFIX=lists/

# Куда передать колбэк PLATEGA, который относится не к нашему заказу.
# Провайдер шлёт уведомления по одному адресу на мерчанта, а платежей два вида:
# железо продаём мы, подписку — бот. Публичный приёмник поэтому один, наш,
# и он передаёт чужие уведомления боту как есть. Пусто — не передавать.
PLATEGA_PARTNER_CALLBACK_URL=http://127.0.0.1:8081/platega/callback
