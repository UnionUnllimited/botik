# nginx на origin, когда витрина уехала за прокси.
# ${ORIGIN_NAME} подставляется envsubst официального образа при старте.
#
# Слушаем только 8443 и только для прокси: 80 и 443 на этом сервере
# заняты чужим Caddy, а публичного имени у нас больше нет. Сертификат
# самоподписанный — его достаточно, потому что проверяет его не браузер,
# а прокси, и проверяет по отпечатку, а не по имени в доверенных корнях.

limit_req_zone $binary_remote_addr zone=device_api:10m rate=120r/m;
limit_req_zone $binary_remote_addr zone=sub_fetch:10m rate=60r/m;

upstream api_upstream {
    server api:8000;
    keepalive 32;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${ORIGIN_NAME};

    ssl_certificate     /etc/nginx/origin-tls/origin.crt;
    ssl_certificate_key /etc/nginx/origin-tls/origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    server_tokens off;
    client_max_body_size 160m;

    proxy_http_version 1.1;
    # Host приходит от прокси и уже несёт публичное имя — не подменяем,
    # приложение собирает по нему абсолютные ссылки.
    proxy_set_header Host $host;
    # Адрес клиента прокси кладёт в X-Forwarded-For, и первый в списке —
    # настоящий. $remote_addr здесь всегда прокси, толку от него нет.
    proxy_set_header X-Real-IP $http_x_real_ip;
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 30s;

    location /api/v1/device/ {
        limit_req zone=device_api burst=30 nodelay;
        proxy_pass http://api_upstream;
        proxy_set_header Connection "";
    }

    location /sub/ {
        limit_req zone=sub_fetch burst=20 nodelay;
        proxy_pass http://api_upstream;
        proxy_set_header Connection "";
    }

    # Образ прошивки идёт роутеру целиком, складывать его на диск незачем.
    location /firmware/ {
        proxy_pass http://api_upstream;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Connection "";
    }

    location = /healthz {
        access_log off;
        proxy_pass http://api_upstream;
    }

    location = /metrics {
        deny all;
    }

    location / {
        proxy_pass http://api_upstream;
        proxy_set_header Connection "";
    }
}

# Всё, что пришло не с нашим именем, — это кто-то стучится по адресу.
# Отвечаем закрытой дверью, а не страницей, по которой нас узнают.
server {
    listen 8443 ssl default_server;
    server_name _;

    ssl_certificate     /etc/nginx/origin-tls/origin.crt;
    ssl_certificate_key /etc/nginx/origin-tls/origin.key;

    return 444;
}
