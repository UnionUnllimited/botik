# ============================================================
#  ОБЯЗАТЕЛЬНЫЕ
# ============================================================

# Токен бота от @BotFather
BOT_TOKEN=

# ID супергруппы с включёнными форум-топиками (-100xxxxxxxxxx)
SUPPORT_CHAT_ID=-

# ID операторов через запятую
ADMIN_IDS=


# ============================================================
#  АДМИНКА 3XUIStore: URL и пароль для интеграции
# ============================================================

# Базовый URL админ-панели (с / на конце). К нему дописывается user_id для кнопки.
ADMIN_PANEL_URL=https://Твоя_Админка/Секрентный_Путь/users/

# Базовый URL админки для API-запросов (с / на конце, БЕЗ /users)
ADMIN_BASE_URL=https://Твоя_Админка/Секрентный_Путь/

# Пароль СЕРВИСНОГО-модератора аккаунта (отдельного, не основного!).
# Если оставить пустым — расширенный блок в шапке тикета будет отключён.
ADMIN_PASSWORD=

# Сколько секунд кэшировать данные клиента (по умолчанию 60).
ADMIN_CACHE_TTL=60

# Таймаут одного запроса в админку, секунды
ADMIN_REQUEST_TIMEOUT=20


# ============================================================
#  БРЕНДОВЫЕ ССЫЛКИ (используются в текстах бота)
#
#  Здесь можно поменять username основного VPN-бота и ссылки
#  на чат сообщества / канал новостей без правки кода.
# ============================================================

# Username основного бота VPN, БЕЗ символа @.
# Будет подставляться во все упоминания вида «@vpn_bot» в текстах.
MAIN_BOT_USERNAME=vpn_bot


# Бренд BRAND_NAME- название вашего впн(для авто вставки во все сообшения)
# Бренд BRAND_SHORT название админки
BRAND_NAME=VPN
BRAND_SHORT=VPN support 


# Полная ссылка на чат сообщества (кнопка «Перейти в чат» - лиюо заменить н свою)
COMMUNITY_CHAT_URL=https://t.me/vpn_chat

# Полная ссылка на канал новостей (упоминается в авто-ответах)
NEWS_CHANNEL_URL=https://t.me/news


# ============================================================
#  ВЕБ-АДМИНКА (доступна по SSH-туннелю на localhost:8080)
# ============================================================

# Логин и пароль входа в веб-админку.
# Поставь сильный пароль, даже если админка только через SSH-туннель.
WEB_ADMIN_LOGIN=admin
WEB_ADMIN_PASSWORD=

# Секрет для подписи cookie-сессий. Если пусто — генерируется
# случайным при каждом старте (всех выкинет из сессии при рестарте).
# Можно задать любую длинную строку, например `openssl rand -hex 32`.
WEB_SESSION_SECRET=

# === Веб-чат (виджет на внешних сайтах) ===
# Порт, на котором бот слушает HTTP API виджета. Не публикуется наружу —
# Caddy проксирует через HTTPS как /api/chat/*
WEB_CHAT_PORT=8090

# ── Парк роутеров (магазин) ─────────────────────────────────────
# Откуда бот берёт состояние роутера клиента для инструмента
# get_my_router. Токен — FLEET_TOKEN из .env магазина.
FLEET_API_URL=https://api.example.ru/fleet
FLEET_API_TOKEN=
