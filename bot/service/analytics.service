[Unit]
Description=Analytics Service
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/bot/analytics
Environment="PATH=/root/bot/analytics/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/root/bot"
ExecStart=/root/bot/analytics/venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536
MemoryMax=1G

[Install]
WantedBy=multi-user.target
