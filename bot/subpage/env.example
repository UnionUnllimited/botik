# ##################################################################
# ⚠️  ОБЯЗАТЕЛЬНО К НАСТРОЙКЕ ПЕРЕД ЗАПУСКОМ
# Проверьте/заполните обе переменные ниже: API_BASE_URL и API_CUSTOM_SETTINGS.
# Остальные параметры — опциональны и имеют рабочие значения по умолчанию.

# ============================================
# [ОБЯЗАТЕЛЬНО] URL основного API сервера (откуда получаем данные подписки)
# Пример на внешнем сервере: https://sub.domain.ru
# Пример под ботом http://127.0.0.1:8282

API_BASE_URL=http://127.0.0.1:8282
# ============================================

# ============================================
# [ОБЯЗАТЕЛЬНО] Подгружать настройки subpage из веб-админки бота
# ============================================
# Конфиг подхватывается при старте subpage И далее периодически без рестарта
# (см. REMOTE_CFG_REFRESH_SEC ниже). Правки в админке применяются автоматически
# каждым воркером (pull-модель, работает и в multi-worker, и когда subpage на
# отдельном сервере — без Redis).

API_CUSTOM_SETTINGS=true

# Как часто (в секундах) перечитывать конфиг из веб-админки без рестарта.
# По умолчанию 30. 0 или отрицательное — отключить периодический опрос (конфиг
# берётся только один раз на старте). Значения <5с автоматически поднимаются
# до 5с, чтобы не нагружать xuiweb. Действует только при API_CUSTOM_SETTINGS=true.
# REMOTE_CFG_REFRESH_SEC=30
# ##################################################################
# ============================================
# Фильтр серверов по меткам [PC]/[MOBILE]/[ROUTER]/[TV] в имени узла.
# • При API_CUSTOM_SETTINGS=false — только эта переменная (true/false).
# • При API_CUSTOM_SETTINGS=true — после старта действует тумблер в админке (Настройки Subpage);
#   значение из .env до первого успешного fetch не переопределяет админку.
#
# PLATFORM_FILTER_ENABLED=false
# ============================================

# ============================================
# Настройки сервера (Не рекомендуется менять)
# ============================================

# Хост для запуска сервера Subpage (0.0.0.0 для всех интерфейсов)
#
HOST=127.0.0.1

# Порт для запуска сервера Subpage
PORT=3004

# ============================================
# Настройки Redis для кэширования и защиты
# ============================================


# Использовать Redis для кэширования (true/false)
USE_REDIS=false

# Хост Redis сервера
REDIS_HOST=127.0.0.1

# Порт Redis сервера
REDIS_PORT=6379

# База данных Redis (0-15)
REDIS_DB=0

# Пароль Redis (оставьте пустым если не используется)
REDIS_PASSWORD=

# Время жизни кэша в Redis (в секундах, по умолчанию 5 сек)
REDIS_CACHE_TTL=5

# ============================================
# Настройки защиты от DDoS (Эксперементальное)
# ============================================

# Включить защиту (rate limiting, IP фильтрация) (true/false)
# ENABLE_SECURITY=false

# Название проекта (будет отображаться в заголовках приложений и на странице)
# Пример: VPN Service
PROJECT_NAME=🛡VPNStore
# Ссылка на поддержку
# Пример: https://t.me/support
# SUPPORT_URL=https://t.me/support

# Ссылка на сайт
# Пример: https://domain.ru
# WEBSITE_URL=https://domain.ru

# Информационный ANNOUNCE текст (Обязательно в одну строчку)
# Для Happ и INCY приложений
# ANNOUNCE_TEXT="↖️ Сайт/Telegram 💳Продлить подписку.\n🔄Чтобы всегда получать актуальный список серверов🌐\nПриятного пользования! 💙"

# Включить/отключить возможность копирования ключей из шаблона
# true - кнопки копирования будут отображаться
# false - кнопки копирования будут скрыты
# ENABLE_COPY_KEYS=false

# Интервал автоматического обновления подписки (в часах)
# Используется для Happ и INCY приложений
# Рекомендуемые значения: 1, 2, 3, 6, 12, 24
# UPDATE_INTERVAL_HOURS=1

# Тема подписки (опционально)
# Доступные темы: subscription, happcrypt, subscription_custom
# Если не указано, используется стандартная тема subscription.html
# SUBSCRIPTION_THEME=subscription


# ============================================
# Ссылки на приложения для скачивания
# Обязательно убедитесь в актуальности ссылок
# ============================================

# Happ для iOS (российский App Store)
LINK_IOS=https://apps.apple.com/ru/app/happ-proxy-utility-plus/id6746188973

# Happ для iOS (международный App Store)
LINK_IOS_GLOBAL=https://apps.apple.com/us/app/happ-proxy-utility/id6504287215

# Happ для Android (Google Play)
LINK_ANDROID=https://play.google.com/store/apps/details?id=com.happproxy

# Happ для Android (APK, GitHub или другой источник)
LINK_ANDROID_APK=https://github.com/Happ-proxy/happ-android/releases/latest/download/Happ.apk

# Happ для Windows
LINK_WINDOWS=https://github.com/Happ-proxy/happ-desktop/releases/latest/download/setup-Happ.x64.exe

# Happ для macOS
LINK_MAC=https://apps.apple.com/ru/app/happ-proxy-utility-plus/id6746188973

# Happ для Linux
LINK_LINUX=https://github.com/Happ-proxy/happ-desktop/releases/

# INCY для iOS 
LINK_INCY_IOS=https://apps.apple.com/us/app/incy/id6756943388

# INCY для Android (Google Play)
LINK_INCY_ANDROID=https://play.google.com/store/apps/details?id=llc.itdev.incy

# INCY для Android (APK, GitHub или другой источник)
LINK_INCY_ANDROID_APK=https://github.com/INCY-DEV/incy-platforms/releases/latest/download/Incy.apk

# INCY для Windows
LINK_INCY_WINDOWS=https://github.com/INCY-DEV/incy-platforms/releases/latest/download/incy-windows-setup.exe

# INCY для macOS
LINK_INCY_MAC=https://github.com/INCY-DEV/incy-platforms

# INCY для Linux
LINK_INCY_LINUX=https://github.com/INCY-DEV/incy-platforms


# Белый список VPN-приложений по User-Agent (подстроки через запятую, без учёта регистра).
# Если НЕ задан (пустой или закомментирован) — подписку получают ВСЕ приложения (поведение по умолчанию).
# Пример: только Happ и INCY
# ALLOWED_APP_USER_AGENTS=happ,incy

# Если true — клиенты, не передающие заголовок X-HWID, получат заглушку
# "Приложение не поддерживается" вместо ключей подписки.
# Браузеры и запросы на веб-страницу подписки не затрагиваются.
# По умолчанию: false
#REQUIRE_HWID=false


# Если на сервере заблокирован доступ к check.happ.su (например, провайдер
# блокирует исходящие или DNS не резолвит), можно прогонять запрос
#   HTTP:    http://user:pass@proxy.example.com:8080
#   SOCKS5:  socks5://user:pass@proxy.example.com:1080
# HAPP_TV_PROXY=http://user:pass@proxy.example.com:8080

# ============================================
# Кастомные HTTP-заголовки ответа подписки
# ============================================
# Любая переменная с префиксом RESP_HEADER_ автоматически добавляется
# как HTTP-заголовок в ответ на запрос подписки от VPN-клиента.
#
# Правило: имя переменной после префикса → lowercase, подчёркивания → дефисы.
#   RESP_HEADER_providerid       →  providerid
#   RESP_HEADER_hide_settings    →  hide-settings
#   RESP_HEADER_profile_update_interval  →  profile-update-interval
#
# ⚠️  ВАЖНО: имена переменных в .env НЕ МОГУТ содержать дефисы.
#     Используйте подчёркивания — они автоматически заменятся на дефисы.
#     Неверно:  RESP_HEADER_hide-settings=1   (дефис в имени — не читается)
#     Верно:    RESP_HEADER_hide_settings=1
#
# Кастомные заголовки применяются ПОСЛЕДНИМИ и могут перекрывать стандартные
# (profile-title, support-url, announce и т.д.).
# Количество заголовков не ограничено.
#
# Если API_CUSTOM_SETTINGS=true и в веб-админке в subpage_config заполнен блок
# «headers» (хотя бы один заголовок), то для ответа подписки берутся ТОЛЬКО
# они — переменные RESP_HEADER_* из .env в этом случае не подмешиваются.
#
# Документация Happ: https://www.happ.su/main/ru/dev-docs/app-management
#
# --- Примеры для приложения Happ ---
#
# Уникальный идентификатор провайдера в Happ.
# Привязывает подписку к вашему аккаунту провайдера — пользователь
# не сможет сменить провайдера вручную.
# RESP_HEADER_providerid=ВАШ_PROVIDER_ID
#
# Запретить просмотр и редактирование конфигураций серверов пользователем.
# 1 — скрыть настройки, 0 — показать (по умолчанию).
# (обратите внимание: подчёркивание → дефис в заголовке автоматически)
# RESP_HEADER_hide_settings=1
#
# Маршрутизация через Happ Routing (base64-закодированный JSON с правилами).
# RESP_HEADER_routing=happ://routing/onadd/ВАША_BASE64_СТРОКА
